// Version information shown in Explorer (Properties > Details) and Task Manager.
// The product is "Stack Neverflow"; the file keeps its old name for compatibility (autostart, updates).
#include <winver.h>

// The exe's icon: generated by make_icon from DrawMark at build time (build/gen/app.ico).
// The first icon group is the one Explorer shows.
1 ICON "app.ico"

// The scanned materials (scripts/gen_scans.py): seamless tiles at 2 px per DIP, found through the repo root
// on the resource compiler's include path.
MAT_OAK       RCDATA "assets/materials/oak.jpg"
MAT_BLACK_ASH RCDATA "assets/materials/black-ash.jpg"
MAT_ALUMINUM  RCDATA "assets/materials/aluminum.jpg"
MAT_ACRYLIC   RCDATA "assets/materials/acrylic.jpg"
MAT_FELT_GRAY RCDATA "assets/materials/felt-gray.jpg"
MAT_QUARTZ    RCDATA "assets/materials/quartz.jpg"
MAT_EBONY     RCDATA "assets/materials/ebony.jpg"
MAT_ONYX      RCDATA "assets/materials/onyx.jpg"
MAT_ACRYLIC_COBALT RCDATA "assets/materials/acrylic-cobalt.jpg"
MAT_ROSEWOOD  RCDATA "assets/materials/rosewood.jpg"
MAT_NACRE     RCDATA "assets/materials/nacre.jpg"
MAT_DAMASCUS  RCDATA "assets/materials/damascus.jpg"
MAT_CLEAR_GLASS RCDATA "assets/materials/clear-glass.jpg"
MAT_CHECKERBOARD RCDATA "assets/materials/checkerboard.jpg"
MAT_TURF RCDATA "assets/materials/turf.jpg"
MAT_LAVA RCDATA "assets/materials/lava.jpg"
MAT_BRICK RCDATA "assets/materials/brick.jpg"
MAT_RATTAN RCDATA "assets/materials/rattan.jpg"
MAT_ITALY_TOWEL RCDATA "assets/materials/italy-towel.jpg"
MAT_MONPE RCDATA "assets/materials/monpe.jpg"

#define SN_VERSION     0,3,0,0
#define SN_VERSION_STR "0.3.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SN_VERSION
 PRODUCTVERSION SN_VERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Stack Neverflow"
            VALUE "FileDescription",  "Stack Neverflow"
            VALUE "FileVersion",      SN_VERSION_STR
            VALUE "InternalName",     "WindowPiles"
            VALUE "OriginalFilename", "WindowPiles.exe"
            VALUE "ProductName",      "Stack Neverflow"
            VALUE "ProductVersion",   SN_VERSION_STR
            VALUE "Comments",         "Tasks stack up, but never overflow."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
